# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=expense_tracker
DB_USER=root
DB_PASS=

# JWT Secret (Change in production!)
JWT_SECRET=your-secret-key-change-in-production-use-long-random-string

# Legacy dev-only login (POST /auth/login -> hardcoded user id=1, NO auth).
# MUST stay false/unset in production. Set true only for local development.
ALLOW_DEV_LOGIN=false

# ── Server-side AI (SMS/statement parsing, dedupe scoring) ──────────────────
# Provider-agnostic via utils/aiClient.php. Pick a provider explicitly with
# AI_PROVIDER, or leave it blank to auto-detect from whichever key is set below.
# Recommended for cost: gemini + gemini-2.0-flash-lite (has a free tier).
#   AI_PROVIDER = gemini | openai | groq | azure | openai_compatible
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash-lite
# AI_BASE_URL=                         # only for openai_compatible / custom base
# AI_API_KEY=                          # generic key for openai_compatible

# Gemini (Google AI Studio key) — default recommended provider
GEMINI_API_KEY=

# Other supported providers (set the matching key + AI_PROVIDER)
OPENAI_API_KEY=
GROQ_API_KEY=
CLAUDE_API_KEY=
# Azure OpenAI (legacy): AZURE_OPENAI_ENDPOINT / _API_KEY / _DEPLOYMENT / _API_VERSION
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4-turbo
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Gmail API (for CAMS statement download)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback

# Google OAuth (multi-user auth). GOOGLE_CLIENT_ID is the OAuth Web client ID
# (= mobile webClientId); Google ID tokens are verified against it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional extra accepted token audiences (comma-separated native Android/iOS
# client IDs) if you add platform-specific Google Sign-In client IDs later.
GOOGLE_ALLOWED_AUDIENCES=

# ── Premium / Google Play Billing ──────────────────────────────────────────
# Gating is OFF until PREMIUM_ENFORCED=true. While off, isPremium() is always
# true so existing/free flows are unaffected.
PREMIUM_ENFORCED=false
# Android package name of the app (e.g. com.shivarya.expensetracker)
GOOGLE_PLAY_PACKAGE_NAME=
# Absolute path to a Play Developer API service-account JSON (read access to the
# app's subscriptions). Keep this file OUTSIDE the web root.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Subscription product IDs configured in Play Console (for reference/mobile)
PREMIUM_PRODUCT_MONTHLY=premium_monthly
PREMIUM_PRODUCT_YEARLY=premium_yearly

# Frontend URL
FRONTEND_URL=http://localhost:19006

