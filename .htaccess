# Enable Rewrite Engine
RewriteEngine On

# Set base for subfolder routing
RewriteBase /expense_tracker/

# Block access to debug and test files
<FilesMatch "^(debug|test)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# HTTPS Redirect (optional, recommended)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Security headers. CORS is handled entirely in index.php (real per-origin
# allowlist, no wildcard) — setting Access-Control-* headers here too would
# let Apache's mod_headers silently override or duplicate PHP's own headers
# depending on processing order, undermining the allowlist.
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# OPTIONS preflight requests are NOT redirected here — they fall through to
# the normal routing below and reach index.php, which already answers them
# directly with the correct CORS headers and a 200. A previous version of
# this rule used `RewriteRule ... [R=204,L]`, but the `R` flag always issues
# an external redirect regardless of the status code passed to it, and
# browsers do not follow redirects for CORS preflight requests — that
# silently broke every cross-origin request that needed a preflight
# (anything sending Authorization or a non-simple method) without ever
# reaching PHP's own correct OPTIONS handling.

# Web app SPA fallback — serve app/index.html for virtual client-side routes
# under /app/ (React Navigation's browser routing, e.g. /app/expenses/current)
# that aren't real files, instead of falling through to the PHP router below.
RewriteCond %{REQUEST_URI} ^/expense_tracker/app(/.*)?$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^app/.*$ /expense_tracker/app/index.html [L]

# Route all requests to index.php (subfolder aware)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /expense_tracker/index.php [QSA,L]

# Protect sensitive files
<Files ".env">
    Order allow,deny
    Deny from all
</Files>

<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Disable directory listing
Options -Indexes
